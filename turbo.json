{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:interop": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "typecheck": {},
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "persistent": true,
      "cache": false
    },
    "//#publish": {
      "outputs": [
        "publish/**"
      ],
      "inputs": [
        "scripts/publish.ts",
        "scripts/run.ts",
        "packages/**",
        "!packages/*/.turbo/**"
      ],
      "env": [
        "API_BASE_URL"
      ],
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "build/**"
      ],
      "cache": true
    },
    "start": {
      "dependsOn": [
        "build"
      ],
      "persistent": true,
      "cache": false
    }
  }
}
