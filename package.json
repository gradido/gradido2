{
  "name": "gradido2",
  "version": "0.0.1",
  "repository": "git@github.com:gradido/gradido2.git",
  "author": "Gradido Academy - https://www.gradido.net",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "lint": "biome check --error-on-warnings scripts contracts && turbo lint",
    "lint:fix": "biome check --error-on-warnings scripts contracts --write && turbo lint:fix",
    "clear": "bun scripts/clean-all.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "turbo": "2.10.5"
  },
  "engines": {
    "node": ">=18.17"
  }
}
