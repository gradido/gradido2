.{
    .name = .fast_servers,
    .version = "0.0.1",
    .minimum_zig_version = "0.15.1",
    // Generated once by the toolchain. Changing it has security and trust implications.
    .fingerprint = 0xc33121de5d4a66ee,
    // Every dependency is pinned to a fixed commit with a hash, per ../AGENTS.md section 13 and
    // fast-servers/AGENTS.md section 3a. A floating dependency in this build is a floating
    // dependency in the process that signs transactions.
    .dependencies = .{
        // The native base library: the money arithmetic, the wire formats, the crypto that
        // backend-core will be written against. Same commit packages/shared-native pins, so the
        // two builds in this repository compile against one layout of the same structs.
        .blockchain_core = .{
            .url = "git+https://github.com/gradido/gradido-blockchain-core.git#ca061e76d1a11804866630c196324602c9b6c4ea",
            .hash = "blockchain_core-0.20.0-r94upuObEQCUnFKzKD-B3AigIijkjh_H7l-DJByNjgn4",
        },
        // libsodium, and the same pin the core carries: the two must be one package in the
        // build graph, or service-core would compile against one copy of sodium.h and link the
        // other. Requested with the core's options for the same reason -- differing options
        // would fork the instance rather than share it.
        .libsodium = .{
            .url = "git+https://github.com/jedisct1/libsodium#77e1ce5d6dee871c49ef211222ba18ef0c486bda",
            .hash = "N-V-__8AAGV3jgBL34nv4uUihxaCgroWLfj966-SVjBHn9RE",
        },
        // arnm: the arena, the containers and the conversions the core is written against, and
        // the JSON jwt.c parses a token with. Same pin and the same options the core requests,
        // for the same reason libsodium is here -- and do not pin its vendored yyjson
        // separately, which would be a second definition of every yyjson_* symbol.
        .arnm = .{
            .url = "https://github.com/gradido/arnm/archive/refs/tags/v0.7.5.tar.gz",
            .hash = "arnm-0.7.5-ZdhGsFiuGgBgKTeY_sObjyGhXvKbhB97imrlnNp9DVe9",
        },
        // The HTTP server on the fast path. build.zig copies the libh2o-evloop source list out
        // of this checkout's CMakeLists.txt, so the pin and that list have to move together.
        //
        // Not lazy, although the Windows build does not compile libh2o: that build takes
        // picohttpparser out of deps/ here, and one pinned checkout both backends read from
        // beats a copy of two files in this repository that nothing would ever compare against
        // the original again.
        .h2o = .{
            .url = "git+https://github.com/h2o/h2o#706842c0f8c0d9422efb97a4d8ef7d6ec9df87b7",
            .hash = "N-V-__8AACufnwFkhWbkiO3KxcVcasJKyoe9sYRvT0rp5-MI",
        },
        // LibreSSL: the TLS h2o is built against, and the TLS libpq speaks to the database.
        //
        // This was allyourcodebase/openssl until arm64 was measured against it. That package is
        // x86_64-only by construction -- it ships pre-generated x86_64 assembly, adds it under
        // `.x86_64 => ...` with `else => {}` beside it, and compiles crypto/bn/asm/x86_64-gcc.c
        // for every target whatever the architecture is. An aarch64 build stops with 23 errors
        // inside it, natively as much as cross, because that choice is made on cpu.arch and not
        // on whether it is a cross build. No version fixes it: `aarch64` and `arm_arch` appear
        // nowhere in that package's history, and its newest commit packs the same OpenSSL 3.3.2
        // as its oldest.
        //
        // LibreSSL is the same API from people who kept it portable: this package handles
        // aarch64 in its config-header switch and adds assembly only where it has it. h2o knows
        // the fork -- lib/common/socket.c branches on LIBRESSL_VERSION_NUMBER in four places.
        //
        // The pin is the commit allyourcodebase/libpq names, down to the hash, so that the
        // database driver's `ssl = .LibreSSL` and h2o's TLS are one package in the graph rather
        // than two exporting the same symbols. When this moves, read libpq's build.zig.zon and
        // move it with them -- the .libpq entry says what breaks otherwise.
        //
        // Lazy: the Windows build has no h2o, gives curl Schannel and builds no libpq, so it
        // wants none of this.
        .libressl = .{
            .url = "git+https://github.com/allyourcodebase/libressl?ref=master#8c63fadf71925d74942a847b9a6b3a28930792a3",
            .hash = "libressl-4.0.0--kqV4FHUAABdqKrbT3i3K-m1m7s_HyZZMMoBpbHjCiNQ",
            .lazy = true,
        },
        // libcurl: the mail client speaks SMTP through it, and the outbound HTTP(S) this
        // project will need later goes the same way rather than through a second library.
        //
        // Pinned at fc863d6 and not at HEAD, because HEAD declares minimum_zig_version 0.16.0
        // and this build is on 0.15.1; fc863d6 is the last commit that still says 0.15.1, and
        // it carries curl 8.18.0. Moving it means moving the toolchain first.
        //
        // Every protocol but SMTP and HTTP is switched off in build.zig, together with the four
        // system libraries curl reaches for by default (libpsl, libssh2, libidn2, nghttp2) --
        // none of which this build carries, and each of which would become a host dependency.
        //
        // Its TLS is mbedtls, which curl pins itself and fetches lazily. Not LibreSSL, although
        // the rest of this build is: curl's package cannot take one -- `// TODO BoringSSL,
        // AWS-LC, LibreSSL, and quictls` is what its build.zig says where the choice is made.
        // Two libraries with the *same* API would be a link-order lottery; mbedtls has its own,
        // so the two coexist in one process. Revisit when that TODO lands.
        .curl = .{
            .url = "git+https://github.com/allyourcodebase/curl.git#fc863d6cbc4a694ff5bb11fc59470142c8682e2b",
            .hash = "curl-8.18.0-mFDAWK_0AABsv8MPtSIjAPCVElXbt1vbzgBOs7plIlUJ",
        },
        // zlib, for h2o's gzip handler -- lib/handler/compress/gzip.c is in the source list
        // above and includes <zlib.h>. It was the host's -lz until OpenSSL stopped being the
        // host's, at which point one remaining system library would have kept the h2o path
        // pinned to the machine it builds on for no gain.
        //
        // Same pin curl carries, for the reason the libressl entry gives: one package in the
        // graph, not two that happen to contain the same code. Lazy, like libressl -- the
        // fallback backend has no gzip handler and asks for neither.
        .zlib = .{
            .url = "git+https://github.com/allyourcodebase/zlib#c5115f4b69ef660f72a835c6638f80508ef284c7",
            .hash = "zlib-1.3.1-1-ZZQ7ldENAAA7qJjUXP6E6xnRuV-jDL9dyoJFc_eb3zQ6",
            .lazy = true,
        },
        // The platform layer: threads and synchronisation now, filesystem, DNS and child
        // processes as they are needed. Not lazy, because every build uses the loop-free half
        // -- see AGENTS.md section 3a. It is also the platform half of the fallback HTTP
        // backend, whose parser comes out of the h2o checkout above.
        .libuv = .{
            .url = "git+https://github.com/allyourcodebase/libuv.git#c1ccce24e1077ae7780857c89fb4b3aeb9080315",
            .hash = "libuv-1.52.0-htqqvzNqAAAB6cHIx-wIffe_mqMW5GOKjHeDBJYHGwls",
        },
        // libpq, the PostgreSQL driver, built by allyourcodebase/libpq out of a pinned postgres
        // checkout -- so this pin carries two, and 5.18.4 is PostgreSQL 18.4. Architecture.md,
        // *Databases*, holds why the driver is libpq and not a protocol client of our own: 3,6
        // us of user CPU out of 48 is the entire budget a rewrite could compete for.
        //
        // Requested with `ssl = .LibreSSL`, which is the package's own default and, here, a
        // requirement: it pins allyourcodebase/libressl at the commit and hash the .libressl
        // entry above names, so both resolve to one package and the process carries one TLS
        // library. Asking it for OpenSSL instead would fetch a second one exporting the same
        // symbols as LibreSSL, and link order would decide which of them verifies a certificate.
        //
        // Lazy: the postgres checkout is 155 MB, and `-Dpostgres=false` never fetches it. Not
        // built on Windows at all -- the package compiles postgres' posix src/port.
        .libpq = .{
            .url = "git+https://github.com/allyourcodebase/libpq#925fa037a81952343b255f88f795257a8006f27d",
            .hash = "libpq-5.18.4-QME6ad0UAQBVEzKd7H4tswrfCnTZB_1Kjw09tXeUKQK1",
            .lazy = true,
        },
        // SQLite, as the amalgamation from sqlite.org rather than through a build.zig of
        // someone else's.
        //
        // It is one C file. allyourcodebase/sqlite3 exists and is 40 lines around exactly this
        // archive, and taking it would add a package whose build.zig declares
        // minimum_zig_version 0.16.0 -- a toolchain floor above this build's, for a compile of
        // one translation unit that build.zig already knows how to do. picohttpparser is in the
        // tree on the same reasoning.
        //
        // Not lazy: 11 MB, and SQLite is what makes a small community's installation a
        // download-and-start affair -- a default build that cannot open one would miss the
        // point of having it.
        .sqlite3 = .{
            .url = "https://sqlite.org/2026/sqlite-amalgamation-3530200.zip",
            .hash = "N-V-__8AALc_rgC04POe18O0LKFRm4ouQpLtL3riscEmWp-Q",
        },
        // googletest, for the unit tests under -Dtests. Same pin as arnm and
        // gradido-blockchain-core, so the three repositories test against one version. Lazy: a build
        // without -Dtests never fetches it.
        .googletest = .{
            .url = "git+https://github.com/allyourcodebase/googletest#e2affdd13730f800aa63772039f2adfa971461b6",
            .hash = "googletest-1.15.2-vLU55gAVAAC86GD--lNpG3oVHLsJhdB0lFCOCsBEbiAE",
            .lazy = true,
        },
        // Feeds compile_commands.json, which is where the -Wall -Wextra findings become visible
        // in an editor -- zig itself hides them on a successful build.
        .compile_commands = .{
            .url = "https://github.com/the-argus/zig-compile-commands/archive/9400cd1963ea6bb58fe47ba7d9700075b808cdd2.tar.gz",
            .hash = "zig_compile_commands-0.0.1-OZg5-e_JAAAGg1WHAePtq4l4Uvjs34BexnFFCZk63EaG",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "CMakeLists.txt",
        "src",
        "service-core",
        "backend-core",
        "backend",
        "federation",
        "dht-node",
        "tests",
        "benchmarks",
    },
}
