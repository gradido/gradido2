{
  "contractVersion": 1,
  "kind": "route",
  "server": "backend",
  "model": "Newsletter",
  "description": "Newsletter subscription, backed by the Klicktipp service.",
  "mount": "/",
  "source": [
    "../gradido/backend/src/graphql/resolver/KlicktippResolver.ts"
  ],
  "routes": [
    {
      "name": "newsletter.unsubscribe",
      "method": "POST",
      "path": "/newsletter/unsubscribe",
      "rights": [
        "UNSUBSCRIBE_NEWSLETTER"
      ],
      "request": null,
      "response": {
        "nullable": false,
        "legacyType": "Boolean",
        "type": "bool"
      },
      "legacy": {
        "resolver": "KlicktippResolver",
        "operation": "mutation",
        "field": "unsubscribeNewsletter",
        "file": "../gradido/backend/src/graphql/resolver/KlicktippResolver.ts"
      },
      "auth": "session",
      "roles": [
        "user",
        "moderator",
        "moderator-ai",
        "admin"
      ]
    },
    {
      "name": "newsletter.subscribe",
      "method": "POST",
      "path": "/newsletter/subscribe",
      "rights": [
        "SUBSCRIBE_NEWSLETTER"
      ],
      "request": null,
      "response": {
        "nullable": false,
        "legacyType": "Boolean",
        "type": "bool"
      },
      "legacy": {
        "resolver": "KlicktippResolver",
        "operation": "mutation",
        "field": "subscribeNewsletter",
        "file": "../gradido/backend/src/graphql/resolver/KlicktippResolver.ts"
      },
      "auth": "session",
      "roles": [
        "user",
        "moderator",
        "moderator-ai",
        "admin"
      ]
    }
  ]
}
