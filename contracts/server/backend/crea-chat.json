{
  "contractVersion": 1,
  "kind": "route",
  "server": "backend",
  "model": "CreaChat",
  "description": "The AI assistant chat thread of one member.",
  "mount": "/",
  "source": [
    "../gradido/backend/src/graphql/resolver/CreaChatResolver.ts"
  ],
  "routes": [
    {
      "name": "creaChat.resume",
