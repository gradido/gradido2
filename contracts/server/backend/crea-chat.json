      "rights": [
        "AI_SEND_MESSAGE"
      ],
      "request": {
        "fields": [
          {
            "name": "threadId",
            "required": true,
            "type": "text",
            "legacyType": "string"
          }
        ]
      },
      "response": {
        "nullable": false,
        "legacyType": "Boolean",
        "type": "bool"
      },
      "legacy": {
        "resolver": "CreaChatResolver",
        "operation": "mutation",
        "field": "deleteThread",
        "file": "../gradido/backend/src/graphql/resolver/CreaChatResolver.ts"
      },
      "auth": "session",
      "roles": [
        "moderator-ai",
        "admin"
      ]
    },
    {
      "name": "creaChat.sendMessage",
      "method": "POST",
      "path": "/crea-chat/send-message",
      "rights": [
        "AI_SEND_MESSAGE"
      ],
      "request": null,
      "response": {
        "nullable": false,
        "legacyType": "CreaChatMessage",
        "type": "object",
        "model": "CreaChatMessage",
        "open": "shape of CreaChatMessage not contracted yet"
      },
      "legacy": {
        "resolver": "CreaChatResolver",
        "operation": "mutation",
        "field": "sendMessage",
        "file": "../gradido/backend/src/graphql/resolver/CreaChatResolver.ts"
      },
      "auth": "session",
      "roles": [
        "moderator-ai",
        "admin"
      ]
    }
