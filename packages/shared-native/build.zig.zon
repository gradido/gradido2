.{
    .name = .shared_native,
    .version = "0.1.0",
    .fingerprint = 0xa3701f833801cf96,
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        // The build template, kept in sync by `c-cpp-zig-build`.
        // Add your own dependencies here with `zig fetch --save <url>`.
        .c_cpp_zig_build = .{ .path = ".zig-native" },
        .blockchain_core = .{
            .url = "git+https://github.com/gradido/gradido-blockchain-core.git#9aaf20d2fb603a7bbd0c19ff3f113b29ea0de4f8",
            .hash = "blockchain_core-0.17.1-r94upvXcDgBsMqABC06mo_JNMWmYB6ZncwFYe0ylc1Pc",
        },
        // arnm is what hostmem became -- arnm 0.5.0 renamed every symbol it has, and
        // blockchain_core 0.17.0 followed. Must stay the version blockchain_core builds
        // against, or the two would compile against different layouts of the same structs.
        .arnm = .{
            .url = "https://github.com/gradido/arnm/archive/refs/tags/v0.7.2.tar.gz",
            .hash = "arnm-0.7.2-ZdhGsCwFGgA0uOWsPFL1vPE1tCGvc2TkG-A5oUQrPVgw",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "napi" },
}
