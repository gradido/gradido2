.{
    .name = .shared_native,
    .version = "0.1.0",
    .fingerprint = 0xa3701f833801cf96,
    .minimum_zig_version = "0.15.1",
    .dependencies = .{
        // The build template, kept in sync by `c-cpp-zig-build`.
        // Add your own dependencies here with `zig fetch --save <url>`.
        .c_cpp_zig_build = .{ .path = ".zig-native" },
        .blockchain_core = .{
            .url = "git+https://github.com/gradido/gradido-blockchain-core.git#bc29d8085e370387c613cdf2abc9f308222a0675",
            .hash = "blockchain_core-0.16.0-r94upiqdDgAd3AayQflFxBXLb74T-tHRofauCPLWv0rs",
        },
        // Must stay the version blockchain_core builds against, or the two would compile
        // against different layouts of the same structs.
        .hostmem = .{
            .url = "https://github.com/einhornimmond/hostmem/archive/refs/tags/v0.4.0.tar.gz",
            .hash = "hostmem-0.4.0-frufwr8zCQDmE7Jc572PQLPwh4rGot8U0qNud9Tqyv3u",
        },
    },
    .paths = .{ "build.zig", "build.zig.zon", "napi" },
}
