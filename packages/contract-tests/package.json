{
  "name": "@gradido/contract-tests",
  "type": "module",
  "private": true,
  "description": "Runs the vectors in contracts/test-vectors against the TypeScript implementation. The C half of the same vectors lives in fast-servers/tests/contract.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "jose": "6.2.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260421.2"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  }
}
