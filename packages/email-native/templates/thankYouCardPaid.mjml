<!--
  thankYouCardPaid/html.pug as MJML -- a spike, not a source.

  How the markers, the includes and the preview settings work is written once, in
  accountActivation.mjml. This file is the six-line skeleton plus what makes this
  mail this mail.
-->
<!-- lang= is layout.pug's html(lang=locale): a slot the RENDERER fills from the
     locale it was called with, not one a caller supplies -- which is why it does
     not show up in the struct. -->
<mjml lang="{{v:locale}}">
  <mj-head>
    <mj-include path="includes/head.mjml" />
    <mj-title>{{t:You passed on %1 GDD with your thank you card|transactionAmount}}</mj-title>
  </mj-head>

  <mj-body>
    <mj-include path="includes/top.mjml" />

    <mj-section padding="15px 25px 0 25px">
      <mj-column>
        <mj-text mj-class="h2">{{t:%1 GDD were passed on with your thank you card|transactionAmount}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 25px 0 25px">
      <mj-column>
        <mj-include path="includes/salutation.mjml" />
        <mj-text mj-class="muted">{{t:%1 GDD have just been passed on with your thank you card.|transactionAmount}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#f5f5f5" border="1px solid #808080" border-radius="24px" padding="20px 8% 40px 8%">
      <mj-section background-color="#f5f5f5">
        <mj-column>
          <mj-text mj-class="h2" padding="20px 0 0 0">{{t:Transaction details}}</mj-text>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">
            {{t:Amount: %1 GDD|transactionAmount}}<br />
            {{t:Recipient: %1 (%2)|recipientName,recipientCommunity}}<br />
            {{t:Reference: %1|transactionMemo}}<br />
            {{t:Card: %1|cardLabel}}
          </mj-text>
          <mj-button mj-class="btn" css-class="btn-gold" background-color="#c58d38"
                      href="{{v:communityURL}}/transactions">{{t:To account}}</mj-button>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:That was not you? Block your card right here — it stops working, your Gradido address stays.}}</mj-text>
          
          <!-- .button-6, the only red in the mails: blocking cannot be taken back from
               the mail, so it must not read as a sibling of the gold button above it. -->
          <mj-button mj-class="btn" css-class="btn-red" background-color="#d0264a"
                      href="{{v:communityURL}}/settings/thank-you-card?block={{v:cardId}}">{{t:Block card}}</mj-button>
          <mj-include path="includes/do-not-reply.mjml" />
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="includes/bottom.mjml" />
  </mj-body>
</mjml>
