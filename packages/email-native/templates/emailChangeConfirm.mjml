<!--
  emailChangeConfirm/html.pug as MJML -- a spike, not a source.

  How the markers, the includes and the preview settings work is written once, in
  accountActivation.mjml. This file is the six-line skeleton plus what makes this
  mail this mail.
-->
<!-- lang= is layout.pug's html(lang=locale): a slot the RENDERER fills from the
     locale it was called with, not one a caller supplies -- which is why it does
     not show up in the struct. -->
<mjml lang="{{v:locale}}">
  <mj-head>
    <mj-include path="includes/head.mjml" />
    <mj-title>{{t:Please confirm your new e-mail address}}</mj-title>
  </mj-head>

  <mj-body>
    <mj-include path="includes/top.mjml" />

    <mj-section padding="15px 25px 0 25px">
      <mj-column>
        <mj-text mj-class="h2">{{t:Confirm new e-mail address}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 25px 0 25px">
      <mj-column>
        <mj-include path="includes/salutation.mjml" />
        <mj-text mj-class="muted">{{t:You want to change the e-mail address of your Gradido account to this address.}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#f5f5f5" border="1px solid #808080" border-radius="24px" padding="20px 8% 40px 8%">
      <mj-section background-color="#f5f5f5">
        <mj-column>
          <mj-text mj-class="h2" padding="20px 0 0 0">{{t:Confirm new e-mail address}}</mj-text>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:Please confirm with one click that this address is yours.}}</mj-text>
          <mj-button mj-class="btn" css-class="btn-gold" background-color="#c58d38"
                      href="{{v:confirmLink}}">{{t:Confirm new address}}</mj-button>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:Or copy the link into your browser window.}}</mj-text>
          <mj-text mj-class="p-content" css-class="clink" padding="0 0 20px 0">
            <a href="{{v:confirmLink}}" style="color:#696c72;">{{v:confirmLink}}</a>
          </mj-text>
          
          <!-- A moment, not a duration: a resent link carries the deadline the change already had. -->
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:The link is valid until %1. After that you can have a new e-mail sent from your settings.|validUntil}}</mj-text>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:If you did not ask for this change, you can simply ignore this e-mail – nothing changes without your confirmation.}}</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="includes/bottom.mjml" />
  </mj-body>
</mjml>
