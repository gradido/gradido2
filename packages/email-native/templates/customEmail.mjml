<!--
  customEmail/html.pug as MJML -- a spike, not a source.

  How the markers, the includes and the preview settings work is written once, in
  accountActivation.mjml. This file is the six-line skeleton plus what makes this
  mail this mail.
-->
<!-- lang= is layout.pug's html(lang=locale): a slot the RENDERER fills from the
     locale it was called with, not one a caller supplies -- which is why it does
     not show up in the struct. -->
<mjml lang="{{v:locale}}">
  <mj-head>
    <mj-include path="includes/head.mjml" />
    <mj-title>{{t:%1 has sent you a message|senderAlias}}</mj-title>
  </mj-head>

  <mj-body>
    <mj-include path="includes/top.mjml" />

    <mj-section padding="20px 25px 0 25px">
      <mj-column>
        <mj-include path="includes/salutation.mjml" />
        <mj-text mj-class="muted">{{t:you have just received a message from %1|senderAlias}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- .subject-block: the same card, but bold and darker -- what a person wrote
         as the subject of their message. -->
    <mj-wrapper background-color="#f5f5f5" border="1px solid #808080" border-radius="16px" padding="5px 8%">
      <mj-section background-color="#f5f5f5">
        <mj-column>
          <mj-text css-class="human-text" font-weight="bold" align="left">{{v:subject}}</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-wrapper background-color="#f5f5f5" border="1px solid #808080" border-radius="24px" padding="20px 8% 40px 8%">
      <mj-section background-color="#f5f5f5">
        <mj-column>
          <mj-text mj-class="p-content" css-class="human-text" align="left">{{v:memo}}</mj-text>
          
          <!--@if senderCommunityUuid-->
          <!-- .button-5, the green one: an answer to a person, and it stands INSIDE the
               card because that is where it is seen. The chatbox icon is cid:chatboxicon
               in production; the path here is written from the template's directory. -->
          <mj-button mj-class="btn-answer" css-class="btn-green" background-color="#53900c"
                      href="{{v:communityURL}}/send/{{v:senderCommunityUuid}}/{{v:senderUuid}}?art=email">{{t:Reply}}</mj-button>
          <!--@endif-->
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="0 25px">
      <mj-column>
        <mj-button mj-class="btn" css-class="btn-gold" background-color="#c58d38"
                    href="{{v:communityURL}}/transactions">{{t:To account}}</mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="includes/bottom.mjml" />
  </mj-body>
</mjml>
