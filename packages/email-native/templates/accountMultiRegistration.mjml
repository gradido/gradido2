<!--
  accountMultiRegistration/html.pug as MJML -- a spike, not a source.

  How the markers, the includes and the preview settings work is written once, in
  accountActivation.mjml. This file is the six-line skeleton plus what makes this
  mail this mail.
-->
<!-- lang= is layout.pug's html(lang=locale): a slot the RENDERER fills from the
     locale it was called with, not one a caller supplies -- which is why it does
     not show up in the struct. -->
<mjml lang="{{v:locale}}">
  <mj-head>
    <mj-include path="includes/head.mjml" />
    <mj-title>{{t:Try To Register Again With Your Email}}</mj-title>
  </mj-head>

  <mj-body>
    <mj-include path="includes/top.mjml" />

    <mj-section padding="15px 25px 0 25px">
      <mj-column>
        <mj-text mj-class="h2">{{t:Try To Register Again With Your Email}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 25px 0 25px">
      <mj-column>
        <mj-include path="includes/salutation.mjml" />
        <mj-text mj-class="muted">{{t:Your email address has just been used again to register an account with Gradido.}}</mj-text>
        <mj-text mj-class="muted">{{t:However, an account already exists for your email address.}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#f5f5f5" border="1px solid #808080" border-radius="24px" padding="20px 8% 40px 8%">
      <mj-section background-color="#f5f5f5">
        <mj-column>
          <mj-text mj-class="h2" padding="20px 0 0 0">{{t:Reset password}}</mj-text>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:If you have forgotten your password, please click here.}}</mj-text>
          <mj-button mj-class="btn" css-class="btn-gold" background-color="#c58d38"
                      href="{{v:resendLink}}">{{t:reset}}</mj-button>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:Or copy the link into your browser window.}}</mj-text>
          <mj-text mj-class="p-content" css-class="clink" padding="0 0 20px 0">
            <a href="{{v:resendLink}}" style="color:#696c72;">{{v:resendLink}}</a>
          </mj-text>
          
          <!--@if helperLink-->
          <!-- EM-013, the doorbell model: only present when the attempt carried a redeem
               code (the cafe case). The guest's name is deliberately NOT in this mail --
               registrant input never travels into a stranger's mailbox; the page behind
               the button shows it. -->
          <mj-text mj-class="h2">{{t:Helping someone at a Gradido café right now?}}</mj-text>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:If someone is sitting next to you who just used your e-mail address to start a Gradido account: continue the setup here. Together you enter their own e-mail address, and they choose their password themselves.}}</mj-text>
          <mj-button mj-class="btn" css-class="btn-gold" background-color="#c58d38"
                      href="{{v:helperLink}}">{{t:I am helping someone set up an account}}</mj-button>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:Or copy the link into your browser window.}}</mj-text>
          <mj-text mj-class="p-content" css-class="clink" padding="0 0 20px 0">
            <a href="{{v:helperLink}}" style="color:#696c72;">{{v:helperLink}}</a>
          </mj-text>
          <!--@endif-->
          
          <mj-text mj-class="h2" color="#d0264a">{{t:Contact support}}</mj-text>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:If you did not try to register again, please contact our support:}}</mj-text>
          <mj-text mj-class="p-content" css-class="clink" padding="0 0 20px 0">
            <a href="mailto:{{v:supportEmail}}" style="color:#696c72;">{{v:supportEmail}}</a>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="includes/bottom.mjml" />
  </mj-body>
</mjml>
