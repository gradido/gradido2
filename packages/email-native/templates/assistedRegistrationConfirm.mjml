<!--
  assistedRegistrationConfirm/html.pug as MJML -- a spike, not a source.

  How the markers, the includes and the preview settings work is written once, in
  accountActivation.mjml. This file is the six-line skeleton plus what makes this
  mail this mail.

  Deliberately NOT the accountActivation template: that one talks about finishing
  the registration by choosing a password, which here is already done. And
  deliberately no request-new-link include -- its button leads to the forgot-password
  page, which would disarm this very confirm link. The validity lines stay, because
  they answer "how long is this link good for".
-->
<!-- lang= is layout.pug's html(lang=locale): a slot the RENDERER fills from the
     locale it was called with, not one a caller supplies -- which is why it does
     not show up in the struct. -->
<mjml lang="{{v:locale}}">
  <mj-head>
    <mj-include path="includes/head.mjml" />
    <mj-title>{{t:Confirm your e-mail address}}</mj-title>
  </mj-head>

  <mj-body>
    <mj-include path="includes/top.mjml" />

    <mj-section padding="15px 25px 0 25px">
      <mj-column>
        <mj-text mj-class="h2">{{t:Your Gradido account is ready}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 25px 0 25px">
      <mj-column>
        <mj-include path="includes/salutation.mjml" />
        <mj-text mj-class="muted">{{t:Together with a Gradido member, an account has just been set up for you — with this e-mail address.}}</mj-text>
        <mj-text mj-class="muted">{{t:Please confirm that this address is yours — only then will your account stay open for good.}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#f5f5f5" border="1px solid #808080" border-radius="24px" padding="20px 8% 40px 8%">
      <mj-section background-color="#f5f5f5">
        <mj-column>
          <mj-text mj-class="h2" padding="20px 0 0 0">{{t:Confirm e-mail address}}</mj-text>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:Please click here to confirm your e-mail address.}}</mj-text>
          <mj-button mj-class="btn" css-class="btn-gold" background-color="#c58d38"
                      href="{{v:confirmLink}}">{{t:Confirm address}}</mj-button>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:Or copy the link into your browser window.}}</mj-text>
          <mj-text mj-class="p-content" css-class="clink" padding="0 0 20px 0">
            <a href="{{v:confirmLink}}" style="color:#696c72;">{{v:confirmLink}}</a>
          </mj-text>
          
          <!--@if minutes-->
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:The link has a validity of %1 hours and %2 minutes.|hours,minutes}}
          {{t:If the validity of the link has already expired, you can have a new link sent to you here.}}</mj-text>
          <!--@else-->
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:The link has a validity of %1 hours.|hours}}
          {{t:If the validity of the link has already expired, you can have a new link sent to you here.}}</mj-text>
          <!--@endif-->
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:You know nothing about this account? Then ignore this e-mail — without confirmation the account stays locked.}}</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="includes/bottom.mjml" />
  </mj-body>
</mjml>
