{
  "name": "@gradido/frontend-core",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*",
    "./testing": "./src/testing/index.ts",
    "./testing/icons": "./src/testing/icons.ts",
    "./src/*": "./src/*",
    "./*": "./src/*"
  },
  "scripts": {
    "clear": "rm -rf node_modules && rm -rf .turbo",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "gettext.js": "2.0.3",
    "mithril": "2.3.8",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/gettext.js": "1.0.3",
    "@types/mithril": "2.2.8",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "sass": "1.101.0"
  }
}
