# Backend the frontend talks to. Empty means the origin the page itself was served from,
# which is what a bundled binary needs — there the backend hands out this app. Development
# needs a value, because vite serves it on a port of its own.
API_BASE_URL=http://localhost:4000

# Sub-path the app is served under, empty for the domain root
BASE_PATH=

# Shown as the community's name on the auth pages
COMMUNITY_NAME=Gradido Entwicklung

# Public website, linked from the auth pages
WEBSITE_URL=https://gradido.net

DEV_SERVER_PORT=3000
