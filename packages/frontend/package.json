{
  "name": "frontend",
  "version": "0.0.1",
  "scripts": {
    "predev": "bun locale:de && bun locale:en",
    "dev": "bunx --bun vite",
    "prebuild": "bun locale:de && bun locale:en",
    "build": "NODE_ENV=production bunx --bun vite build",
    "preserve": "bun locale:de && bun locale:en",
    "serve": "bunx --bun vite preview",
    "extract": "bunx --bun gettext-extract",
    "locale:de": "node ../../node_modules/gettext.js/bin/po2json src/locales/de/messages.po src/locales/de/messages.json",
    "locale:en": "node ../../node_modules/gettext.js/bin/po2json src/locales/en/messages.po src/locales/en/messages.json"
  },
  "dependencies": {
    "@iconify-json/simple-icons": "^1.2.25",
    "@trpc/client": "^10.45.2",
    "backend": "workspace:*",
    "bootstrap": "^5.3.3",
    "gettext.js": "^2.0.3",
    "mithril": "^2.2.14",
    "shared": "workspace:*",
    "trpc": "^0.11.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@iconify-json/mdi": "^1.2.3",
    "@mojojoejo/vite-plugin-purgecss": "^1.1.0",
    "@popperjs/core": "^2.11.8",
    "@types/bootstrap": "^5.2.10",
    "@types/bun": "^1.2.2",
    "@types/gettext.js": "^1.0.3",
    "@types/mithril": "^2.2.7",
    "gettext-extract": "^2.0.1",
    "lightningcss": "^1.29.1",
    "sass-embedded": "^1.85.0",
    "unplugin-icons": "^22.1.0",
    "unplugin-vue-components": "^28.4.0",
    "vite": "^6.1.1",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-html": "^3.2.2"
  }
}