{
  "name": "@gradido/frontend",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "author": "Gradido Academy - https://www.gradido.net",
  "scripts": {
    "build": "NODE_ENV=production bun --bun vite build",
    "clear": "rm -rf node_modules build .turbo public/locales",
    "dev": "bun --bun vite",
    "extract": "bun --bun gettext-extract",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write",
    "locale": "bun scripts/localeJson.ts",
    "prebuild": "bun run locale",
    "predev": "bun run locale",
    "start": "bun --bun vite preview",
    "test": "bun test",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@elysiajs/eden": "1.4.9",
    "@gradido/frontend-core": "workspace:*",
    "@gradido/shared": "workspace:*",
    "bootstrap": "5.3.8",
    "mithril": "2.3.8",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@fullhuman/postcss-purgecss": "7.0.2",
    "@gradido/backend": "workspace:*",
    "@iconify-json/bi": "1.2.7",
    "@types/bun": "1.3.14",
    "@types/mithril": "2.2.8",
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "cssnano": "7.1.9",
    "dotenv": "17.4.2",
    "elysia": "1.4.29",
    "gettext-extract": "2.0.1",
    "po2json": "0.4.5",
    "postcss": "8.5.20",
    "sass": "1.101.0",
    "unplugin-icons": "22.5.0",
    "vite": "7.3.6",
    "vite-plugin-environment": "1.1.3",
    "vite-plugin-html": "3.2.2"
  }
}
