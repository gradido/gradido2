{
  "js": {
    "parsers": [
      { "expression": "t.__", "arguments": { "text": 0 } },
      { "expression": "t._n", "arguments": { "text": 0, "textPlural": 1 } },
      { "expression": "t._p", "arguments": { "context": 0, "text": 1 } }
    ],
    "glob": {
      "pattern": "{src,../frontend-core/src}/**/*.ts",
      "options": { "ignore": "**/*.spec.ts" }
    }
  },
  "headers": { "Language": "" },
  "output": "src/locales/messages.pot"
}
