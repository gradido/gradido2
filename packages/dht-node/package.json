{
  "name": "@gradido/dht-node",
  "type": "module",
  "description": "The dht-node role on the reference path: js-libp2p, the same node as fast-servers/dht-node",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts",
    "./*": [
      "./src/*/index.ts",
      "./src/*.ts",
      "./src/*"
    ]
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write",
    "start": "bun src/index.ts",
    "test": "bun test src",
    "test:interop": "bun test ./interop",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-quic": "2.1.4",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@gradido/service-core": "workspace:*",
    "@gradido/shared": "workspace:*",
    "@libp2p/autonat": "3.0.28",
    "@libp2p/circuit-relay-v2": "4.2.13",
    "@libp2p/crypto": "5.1.23",
    "@libp2p/dcutr": "3.0.28",
    "@libp2p/gossipsub": "17.1.1",
    "@libp2p/identify": "4.1.14",
    "@libp2p/interface": "3.3.0",
    "@libp2p/kad-dht": "16.4.5",
    "@libp2p/peer-id": "6.0.15",
    "@libp2p/ping": "3.1.13",
    "@libp2p/tcp": "11.0.28",
    "@multiformats/multiaddr": "13.0.3",
    "dotenv": "17.4.2",
    "libp2p": "3.3.11",
    "multiformats": "14.0.5",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260421.2"
  }
}
