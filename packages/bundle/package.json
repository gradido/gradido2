{
  "name": "@gradido/bundle",
  "description": "The whole reference implementation as one executable: every service, the built frontends, and the native addons. See scripts/bundle.ts at the repository root.",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "author": "Gradido Academy - https://www.gradido.net",
  "license": "Apache-2.0",
  "repository": "git@github.com:gradido/gradido2.git",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*/index.ts",
      "./src/*.ts",
      "./src/*"
    ]
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@gradido/backend": "workspace:*",
    "@gradido/email-native": "workspace:*",
    "@gradido/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260421.2"
  }
}
