{
  "name": "@gradido/backend",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": [
      "./src/*/index.ts",
      "./src/*.ts",
      "./src/*"
    ]
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --error-on-warnings . --write",
    "start": "bun src/index.ts",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@gradido/backend-core": "workspace:*",
    "@gradido/service-core": "workspace:*",
    "@gradido/shared": "workspace:*",
    "dotenv": "17.4.2",
    "elysia": "1.4.29",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "@typescript/native-preview": "7.0.0-dev.20260421.2"
  }
}
