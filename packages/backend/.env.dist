# Copy to .env and adjust. Everything here has a default; the file exists to show what
# there is, not because the server needs it to start.

# sqlite (the default: one file, no service to run) or postgresql (the reference, for a
# community with an administrator). Everything below applies to one of the two.
DB_TYPE=sqlite

# DB_TYPE=sqlite — relative paths are resolved against the working directory
DB_FILE=./gradido_community.sqlite

# DB_TYPE=postgresql — DB_PASSWORD may not be empty when NODE_ENV=production
DB_HOST=localhost
# 15432 for the development container of the root docker-compose.yml, which deliberately
# does not sit on 5432 -- README.md, "Development containers"
DB_PORT=5432
DB_USER=gradido
DB_PASSWORD=
DB_DATABASE=gradido_community

BACKEND_PORT=4000

# Where this instance sends its mail. The names are legacy's, so a community moving to
# gradido2 does not have to relearn them; EMAIL_SMTP_TLS and EMAIL_SENDER_NAME are new.
# false is a working configuration: an instance that has not been told where to send mail
# sends none rather than failing to start.
EMAIL=false
EMAIL_SMTP_HOST=localhost
# 587 for a relay on the internet, 1026 for the maildev container of the root
# docker-compose.yml -- README.md, "Development containers"
EMAIL_SMTP_PORT=587
# none | starttls | require | implicit -- plain, upgrade if offered, upgrade or refuse the
# relay, or TLS from the first byte, which is what port 465 means. `require` is what a relay
# on the far side of the internet deserves; `none` is what maildev speaks.
EMAIL_SMTP_TLS=starttls
# SMTP AUTH, both or neither. Empty for a relay that wants no login.
EMAIL_USERNAME=
EMAIL_PASSWORD=
# The envelope sender and the display name in front of it. Needed when EMAIL=true.
EMAIL_SENDER=
EMAIL_SENDER_NAME=

# Only for `migrate-down`, and only needed on a release. The migration the database should
# end at — one lower than where it is now — or 0 for an empty database. So at 0002_users:
#
#   NODE_ENV=production DB_MIGRATE_DOWN=0001_communities bun src/index.ts migrate-down
#
# The target rather than a yes, because it stops being one lower the moment it is reached: a
# value left behind here cannot take the next step down. Going down destroys whatever the
# migration being undone held; read its down file in contracts/migrations first.
DB_MIGRATE_DOWN=

# development pretty-prints to the console, everything else writes contracted JSON
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# empty means stdout only
LOG_FILE=
