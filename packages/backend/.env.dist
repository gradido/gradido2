# Copy to .env and adjust. Everything here has a default; the file exists to show what
# there is, not because the server needs it to start.

# sqlite (the default: one file, no service to run) or postgresql (the reference, for a
# community with an administrator). Everything below applies to one of the two.
DB_TYPE=sqlite

# DB_TYPE=sqlite — relative paths are resolved against the working directory
DB_FILE=./gradido_community.sqlite

# DB_TYPE=postgresql — a DB_HOST beginning with "/" is a Unix socket directory, anything
# else is a host name or address and means TCP. The socket is the default because it is the
# faster of the two for a database on this machine; a database elsewhere is named here and
# gets TCP by being named. See contracts/database-config.json.
#
# DB_PASSWORD may not be empty when NODE_ENV=production *and* the connection is TCP. Over a
# socket no password is the correct configuration, and the rule does not ask for one.
#
# The development container of the root docker-compose.yml needs the TCP line below rather
# than the default: it is reached over a port, not over this machine's socket directory.
DB_HOST=/var/run/postgresql
# DB_HOST=localhost
# 15432 for the development container of the root docker-compose.yml, which deliberately
# does not sit on 5432 -- README.md, "Development containers"
DB_PORT=5432
DB_USER=gradido
# The environment is the last of three sources for a password, and the one that leaks: it is
# readable in /proc/<pid>/environ, is inherited by every child process, and turns up in
# `docker inspect` and in crash dumps. The other two, in the order they win:
#
#   LoadCredential=DB_PASSWORD:/etc/gradido/db_password   in a systemd unit
#   DB_PASSWORD_FILE=/run/secrets/db_password            a path, not the password
#
# Both are files, which is how docker and kubernetes secrets arrive anyway. A file that is
# named and cannot be read stops the start rather than falling back to the line below.
# See contracts/secrets.json.
DB_PASSWORD=
DB_DATABASE=gradido_community

BACKEND_PORT=4000

# Only for `migrate-down`, and only needed on a release. The migration the database should
# end at — one lower than where it is now — or 0 for an empty database. So at 0002_users:
#
#   NODE_ENV=production DB_MIGRATE_DOWN=0001_communities bun src/index.ts migrate-down
#
# The target rather than a yes, because it stops being one lower the moment it is reached: a
# value left behind here cannot take the next step down. Going down destroys whatever the
# migration being undone held; read its down file in contracts/migrations first.
DB_MIGRATE_DOWN=

# development pretty-prints to the console, everything else writes contracted JSON
NODE_ENV=development
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# empty means stdout only
LOG_FILE=
